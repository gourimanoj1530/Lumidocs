# ─────────────────────────────────────────────────────────
#  .env — local development environment variables
#  Copy this file and rename it .env before running docker compose
#  Never commit the real .env to git!
# ─────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docdb
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpassword
DATABASE_URL=postgresql://docuser:docpassword@localhost:5432/docdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_THUMBNAILS=thumbnails

# AI — replace with your real key
# gemini.api-key=AIzaSyAzKx1oWrUE6x2B5LoUbTDUmBarG42ySmA
# App
APP_PORT=8080
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24
